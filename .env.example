# ── mh-api (Express) ─────────────────────────────────────────────────────────────
NODE_ENV=development
# VPS: keep 127.0.0.1 — Nginx proxies api.monowarahospital.com → 127.0.0.1:5020
HOST=127.0.0.1
PORT=5036

# Local: mongodb://127.0.0.1:27017/monowara
# VPS:   mongodb://mh_api:<password>@127.0.0.1:27017/monowara?authSource=monowara
MONGODB_URI=mongodb://127.0.0.1:27017/monowara

# Browser origins allowed to call the API with cookies (admin dashboard, public forms). Comma-separated.
# VPS: https://monowarahospital.com,https://www.monowarahospital.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Nginx on the same box → loopback. Never "true".
TRUST_PROXY=loopback
RATE_LIMIT_PUBLIC_PER_MIN=300

# Optional: lets a trusted machine that is NOT the VPS (e.g. `next build` on CI) skip the public
# rate limit with header x-mh-internal-key. ≥ 32 random chars. Leave empty if unused.
INTERNAL_API_KEY=

LOG_LEVEL=info

# ── Admin auth (B1.3) ──
# Required. ≥ 32 random chars, different per environment. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MIN=10
# Auto logout after this many idle minutes; hard session limit in days
SESSION_IDLE_MIN=30
SESSION_MAX_DAYS=7
# Per-account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MIN=15
# Leave empty (host-only cookie on api.monowarahospital.com). Secure cookies default to on in production.
COOKIE_DOMAIN=
# COOKIE_SECURE=true

# ── Files (B1.4) ──
# Public images (served at /uploads). VPS: /var/www/mh/uploads — copy mh-front/public/uploads there first.
# Dev: point it at the frontend's folder so seeded AND newly uploaded images live in one place, then set
# MEDIA_ORIGIN=http://localhost:5036 in mh-front/.env (API mode) to see uploads without restarting Next.
UPLOAD_DIR=../mh-front/public/uploads
# CVs. Must NOT be web-served. VPS: /var/www/mh/private
PRIVATE_DIR=./private
# Dev only: API serves UPLOAD_DIR at http://localhost:5036/uploads (set MEDIA_ORIGIN in mh-front to match)
SERVE_UPLOADS=true
UPLOAD_MAX_MB=10
CV_MAX_MB=5

# ── Mail (B1.4) — leave SMTP_HOST empty to disable alerts ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail: an App Password (Google Account → Security → App passwords), not the account password
SMTP_PASS=
# MAIL_FROM="Monowara Hospital Website" <no-reply@monowarahospital.com>
# Who gets "new message / booking / application" alerts (comma-separated)
ADMIN_EMAIL=
# Link added to alert emails, e.g. https://monowarahospital.com
ADMIN_URL=

# Seed script only: path to the frontend repo whose data/*.js is imported
MH_FRONT_DIR=../mh-front
