{
    "name": "mh-back",
    "version": "0.1.0",
    "private": true,
    "description": "Monowara Hospital API (Express + MongoDB) — serves mh-front and the admin dashboard",
    "type": "module",
    "main": "src/server.js",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/server.js",
        "start": "node --env-file-if-exists=.env src/server.js",
        "seed": "node --env-file-if-exists=.env --no-warnings scripts/seed.mjs",
        "check": "node scripts/check-syntax.mjs",
        "create-admin": "node --env-file-if-exists=.env --no-warnings scripts/create-admin.mjs",
        "test": "node --no-warnings test/parity.test.mjs && node --no-warnings test/auth.test.mjs && node --no-warnings test/forms-uploads.test.mjs && node --no-warnings test/doctors-admin.test.mjs && node --no-warnings test/services-admin.test.mjs && node --no-warnings test/content-admin.test.mjs && node --no-warnings test/final-admin.test.mjs"
    },
    "dependencies": {
        "bcryptjs": "3.0.3",
        "cookie-parser": "1.4.7",
        "cors": "2.8.5",
        "exceljs": "4.4.0",
        "express": "^5.3.0",
        "express-rate-limit": "8.1.0",
        "helmet": "8.1.0",
        "jsonwebtoken": "9.0.3",
        "mongoose": "^9.11.4",
        "multer": "2.4.0",
        "nodemailer": "10.0.16",
        "pino": "9.13.1",
        "pino-http": "10.5.0",
        "sharp": "0.35.5",
        "zod": "4.1.12"
    },
    "devDependencies": {
        "esbuild": "0.25.10",
        "pino-pretty": "13.1.2"
    }
}
